# Build tooling and sources are not needed at runtime.
src/**
test/**
.github/**
# Only the Marketplace-sized icon ships; the 512px copy is for docs/panels.
assets/icon-512.png
tsconfig.json
esbuild.mjs
.gitignore
.npmignore
*.vsix

# Source maps.
**/*.map

# Only the bundled extension entry ships. tsc's per-file ESM output and the
# bundled MCP server (dist/mcp.cjs, an npm-only entry point) are unused by the
# extension host.
dist/**
!dist/extension.cjs

# node_modules: ship only the extension's runtime dependency closure.
# The bundle requires `vscode` (provided by the host) plus `web-tree-sitter`,
# and resolves the grammar wasms by path, so the four package manifests stay.
node_modules/**
!node_modules/web-tree-sitter/package.json
!node_modules/web-tree-sitter/web-tree-sitter.cjs
!node_modules/web-tree-sitter/web-tree-sitter.wasm
!node_modules/tree-sitter-python/package.json
!node_modules/tree-sitter-python/tree-sitter-python.wasm
!node_modules/tree-sitter-javascript/package.json
!node_modules/tree-sitter-javascript/tree-sitter-javascript.wasm
!node_modules/tree-sitter-typescript/package.json
!node_modules/tree-sitter-typescript/tree-sitter-typescript.wasm
!node_modules/tree-sitter-typescript/tree-sitter-tsx.wasm
