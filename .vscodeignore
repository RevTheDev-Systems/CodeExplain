# Build tooling and sources are not needed at runtime.
src/**
test/**
tsconfig.json
esbuild.mjs
.gitignore
*.vsix

# Source maps.
**/*.map

# tsc's per-file ESM output is dead weight: the extension entry is dist/extension.cjs.
dist/index.js
dist/cli.js
dist/extension.js
dist/parser/**
dist/llm/**
dist/analyzer/**
dist/extension/**

# Native addon helpers are unused: grammars are loaded as WebAssembly.
node_modules/node-addon-api/**
node_modules/node-gyp-build/**

# Keep only the grammar wasm + package manifests from the tree-sitter packages.
node_modules/tree-sitter-*/src/**
node_modules/tree-sitter-*/prebuilds/**
node_modules/tree-sitter-*/bindings/**
node_modules/tree-sitter-*/queries/**
node_modules/tree-sitter-*/common/**
node_modules/tree-sitter-*/typescript/**
node_modules/tree-sitter-*/tsx/**
node_modules/tree-sitter-*/node_modules/**
node_modules/tree-sitter-*/grammar.js
node_modules/tree-sitter-*/binding.gyp
node_modules/tree-sitter-*/README.md
node_modules/tree-sitter-*/LICENSE
node_modules/tree-sitter-*/tree-sitter.json

# web-tree-sitter: keep the CJS entry + runtime wasm only.
node_modules/web-tree-sitter/debug/**
node_modules/web-tree-sitter/web-tree-sitter.js
node_modules/web-tree-sitter/web-tree-sitter.d.ts
node_modules/web-tree-sitter/web-tree-sitter.d.cts
node_modules/web-tree-sitter/README.md
node_modules/web-tree-sitter/LICENSE
